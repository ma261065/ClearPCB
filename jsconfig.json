{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": false
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "assets/vendor/**",
    ".venv/**"
  ]
}
